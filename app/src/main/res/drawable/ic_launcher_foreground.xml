<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: titanium horn emitting amber pressure waves.
     Geometry stays inside the adaptive-icon 66dp safe circle (viewport 108, center 54). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Driver block -->
    <path android:pathData="M32,47 h8 a4,4 0 0 1 4,4 v6 a4,4 0 0 1 -4,4 h-8 a4,4 0 0 1 -4,-4 v-6 a4,4 0 0 1 4,-4 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28" android:startY="47"
                android:endX="28" android:endY="61">
                <item android:offset="0" android:color="#FFDCE4EA" />
                <item android:offset="1" android:color="#FF5F6E7A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bell (flared horn body) -->
    <path android:pathData="M42,48 C52,45 58,41 66,38 L66,70 C58,67 52,63 42,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="42" android:startY="38"
                android:endX="42" android:endY="70">
                <item android:offset="0" android:color="#FFF4F8FB" />
                <item android:offset="0.55" android:color="#FFAEBDC9" />
                <item android:offset="1" android:color="#FF5E6D79" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular streak along the bell crown -->
    <path
        android:pathData="M45,50 C53,47 59,43.5 63.5,41"
        android:strokeColor="#66FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2" />

    <!-- Amber mouth rim -->
    <path
        android:pathData="M66,38 C70,45 70,63 66,70"
        android:strokeColor="#FFFFB547"
        android:strokeLineCap="round"
        android:strokeWidth="3.2" />

    <!-- Pressure waves -->
    <path
        android:pathData="M70,42 C73,47 73,61 70,66"
        android:strokeColor="#FFFFB547"
        android:strokeLineCap="round"
        android:strokeWidth="2.6" />
    <path
        android:pathData="M75.5,38 C79.5,45 79.5,63 75.5,70"
        android:strokeColor="#B3FFB547"
        android:strokeLineCap="round"
        android:strokeWidth="2.4" />
    <path
        android:pathData="M81,36 C85,44 85,64 81,72"
        android:strokeColor="#66FFB547"
        android:strokeLineCap="round"
        android:strokeWidth="2.2" />
</vector>
