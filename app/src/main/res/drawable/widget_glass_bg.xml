<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded translucent-look gradient card for the Glance widget.
     RemoteViews cannot blur real backdrops, so the glass feel is approximated with a
     vertical gradient + hairline rim that stays readable on light and dark launchers. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FF151D24"
                android:startColor="#FF242F38" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
