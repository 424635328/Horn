<?xml version="1.0" encoding="utf-8"?>
<!-- Machined carbon plate for the Glance widget.
     RemoteViews cannot draw gradients with strokes, so the plate is a two-layer drawable:
     an anthracite vertical gradient plus a 1 dp engraved hairline rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FF12151A"
                android:startColor="#FF1D2129" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#FF2C313C" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
