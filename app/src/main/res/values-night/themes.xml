<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Horn" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0E11</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Dark twin of Theme.Horn.Starting so the system splash never flashes white. -->
    <style name="Theme.Horn.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0E11</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Horn</item>
    </style>
</resources>
